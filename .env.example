# =============================================================================
# GeekAI Root Environment Configuration
# =============================================================================
# Copy this file to .env or use the respective service .env files:
#   backend/.env
#
# Production secrets are supplied by the environment or a secrets manager,
# never by this file. Every value below is a placeholder that cannot be used
# to reach a real database or sign a token.

# --- PostgreSQL Database (Neon Serverless / Local Docker) ---
# Production (Vercel): Use Neon pooled connection string (-pooler) with ?sslmode=require
# Migrations (Alembic): Use Neon direct connection string (without -pooler)
# Local Docker: postgresql+asyncpg://geekai:<password>@postgres:5432/geekai
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<neon-host>-pooler.aws.neon.tech/neondb?sslmode=require
POSTGRES_USER=<set-POSTGRES_USER>
POSTGRES_PASSWORD=<set-POSTGRES_PASSWORD>
POSTGRES_DB=geekai

# --- Security & JWT ---
SECRET_KEY=<generate-a-random-value>
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- One-time bootstrap token (required before first boot) ---
BOOTSTRAP_TOKEN=<set-BOOTSTRAP_TOKEN-in-the-environment>

# --- Active event code for JWT event_ids scope ---
ACTIVE_EVENT_CODE=oas-2026

# --- QR signing-key placeholders (stage S5 uses real values) ---
QR_SIGNING_KEY=<set-QR_SIGNING_KEY-in-the-environment>
QR_KEY_ID=<set-QR_KEY_ID-in-the-environment>
QR_ISSUER=geekai-hub-01

# --- CORS ---
# Set to your production Vercel domain(s), comma-separated
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# --- SMTP (Optional email delivery for QR codes) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@geekai.in
SMTP_USE_TLS=true

# --- Upload & Storage Backend ---
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Cashfree Payment Gateway ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
BACKEND_URL=http://localhost:8000
