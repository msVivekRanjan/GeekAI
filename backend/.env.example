# =============================================================================
# GeekAI Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
#
# Production secrets are supplied by the environment or a secrets manager,
# never by this file. Every value below is a placeholder that cannot be used
# to reach a real database or sign a token.

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/geekai

# JWT
SECRET_KEY=<generate-a-random-value>
ACCESS_TOKEN_EXPIRE_MINUTES=480

# One-time bootstrap token (required before first boot).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOOTSTRAP_TOKEN=<set-BOOTSTRAP_TOKEN-in-the-environment>

# Active event code used for JWT event_ids scope checks.
ACTIVE_EVENT_CODE=oas-2026

# QR signing-key placeholders (stage S5 uses real values). These are NOT
# usable signing keys — never put a real private key in this file.
QR_SIGNING_KEY=<set-QR_SIGNING_KEY-in-the-environment>
QR_KEY_ID=<set-QR_KEY_ID-in-the-environment>
QR_ISSUER=geekai-hub-01

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SMTP (optional — leave blank to skip email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@geekai.in
SMTP_USE_TLS=true

# File uploads
UPLOAD_DIR=uploads

# Cashfree Payment Gateway
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
BACKEND_URL=http://localhost:8000
